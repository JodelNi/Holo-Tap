<UserControl x:Class="Holo.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Diagnostics"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="Audio hardware and signal diagnostics."
                       FontSize="13" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8"
                    Padding="24" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Audio Device Info" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                    <TextBlock x:Name="DeviceInfo" Text="Initializing..." FontSize="12" />

                    <TextBlock Text="Signal Quality" FontWeight="SemiBold" FontSize="14" Margin="0,12,0,8" />
                    <TextBlock x:Name="SignalInfo" Text="Not available" FontSize="12" Foreground="Gray" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
