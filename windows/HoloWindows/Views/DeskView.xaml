<UserControl x:Class="Holo.Views.DeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Desk — Tap Zone Map"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <Grid Width="480" Height="360">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Rear -->
                <Border x:Name="LRBorder" Grid.Row="0" Grid.Column="0" Margin="8"
                        Background="#E8F0FE" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Left Rear" FontWeight="SemiBold" FontSize="14" Foreground="#0078D4" />
                        <TextBlock x:Name="LRAction" Text="Visual only" FontSize="11" Foreground="Gray" Margin="0,4,0,0" />
                        <TextBlock x:Name="LRConfidence" Text="" FontSize="10" Foreground="#4CAF50" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Right Rear -->
                <Border x:Name="RRBorder" Grid.Row="0" Grid.Column="2" Margin="8"
                        Background="#E8F0FE" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Right Rear" FontWeight="SemiBold" FontSize="14" Foreground="#0078D4" />
                        <TextBlock x:Name="RRAction" Text="Visual only" FontSize="11" Foreground="Gray" Margin="0,4,0,0" />
                        <TextBlock x:Name="RRConfidence" Text="" FontSize="10" Foreground="#4CAF50" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- MacBook silhouette -->
                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                        Width="160" Height="280" VerticalAlignment="Center"
                        Background="#2D2D2D" CornerRadius="12" BorderThickness="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="MacBook" Foreground="White" FontSize="11" Opacity="0.6" />
                        <Rectangle Height="60" Width="100" RadiusX="4" RadiusY="4"
                                   Fill="#444" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Left Front -->
                <Border x:Name="LFBorder" Grid.Row="2" Grid.Column="0" Margin="8"
                        Background="#E8F0FE" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Left Front" FontWeight="SemiBold" FontSize="14" Foreground="#0078D4" />
                        <TextBlock x:Name="LFAction" Text="Visual only" FontSize="11" Foreground="Gray" Margin="0,4,0,0" />
                        <TextBlock x:Name="LFConfidence" Text="" FontSize="10" Foreground="#4CAF50" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- Right Front -->
                <Border x:Name="RFBorder" Grid.Row="2" Grid.Column="2" Margin="8"
                        Background="#E8F0FE" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Right Front" FontWeight="SemiBold" FontSize="14" Foreground="#0078D4" />
                        <TextBlock x:Name="RFAction" Text="Visual only" FontSize="11" Foreground="Gray" Margin="0,4,0,0" />
                        <TextBlock x:Name="RFConfidence" Text="" FontSize="10" Foreground="#4CAF50" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="12,8" Background="#FAFAFA" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="StatusMessage"
                               Text="Set up your desk via Calibration to begin."
                               FontSize="12" Foreground="Gray" />
                    <TextBlock x:Name="LastTapInfo" Text="" FontSize="11" Foreground="#666" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
