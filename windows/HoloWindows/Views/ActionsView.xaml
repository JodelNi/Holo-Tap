<UserControl x:Class="Holo.Views.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Actions"
                       FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />
            <TextBlock Text="Assign actions to each desk zone."
                       FontSize="13" Foreground="Gray"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8"
                    Padding="24" Background="#FAFAFA">
                <StackPanel>
                    <TextBlock Text="Zone Actions" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                    <TextBlock Text="Left Rear: Visual only" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="Left Front: Visual only" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="Right Rear: Visual only" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="Right Front: Visual only" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="Available actions:" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,8" />
                    <TextBlock Text="• Play a sound" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="• Copy text to clipboard" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="• Speak text (TTS)" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="• Open a website" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="• Open an app or file" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="• Run a command" FontSize="11" Margin="0,0,0,2" />
                    <TextBlock Text="• Take a screenshot" FontSize="11" Margin="0,0,0,8" />

                    <TextBlock Text="TODO: Full action editor with pickers for each zone."
                               FontSize="11" Foreground="Orange" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
