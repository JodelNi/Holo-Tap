<UserControl x:Class="Holo.Views.EvaluationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Setup panel -->
        <StackPanel x:Name="SetupPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Visible">
            <TextBlock Text="Accuracy Test"
                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Measure how well the classifier identifies your taps."
                       FontSize="13" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,24" />

            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8"
                    Padding="24" Background="#FAFAFA" Width="440">
                <StackPanel>
                    <TextBlock Text="How it works" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
                    <TextBlock Text="• Tap each zone 15 times (60 total)" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="• Rejections count as incorrect" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="• Requires a calibrated profile" FontSize="12" Margin="0,0,0,4" />
                    <TextBlock Text="• Target: ≥80% accuracy, &lt;200 ms latency" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock x:Name="ActiveProfileInfo" Text="No active profile"
                               FontSize="12" Foreground="Gray" Margin="0,0,0,12" />

                    <Button x:Name="StartButton" Content="Start Evaluation"
                            Padding="16,10" Background="#0078D4" Foreground="White"
                            IsEnabled="False" Click="OnStartEvaluation" />

                    <Separator Margin="0,12" />
                    <TextBlock Text="Previous results" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <ItemsControl x:Name="HistoryList" MaxHeight="180">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Active evaluation panel -->
        <StackPanel x:Name="ActivePanel" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
            <TextBlock Text="Accuracy Test — Live"
                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" />

            <Border x:Name="ZoneIndicator" BorderBrush="#0078D4" BorderThickness="2" CornerRadius="8"
                    Padding="12" Background="#FFF8E1" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="CurrentZoneName" FontSize="18" FontWeight="SemiBold"
                               Foreground="#0078D4" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CurrentZoneCount" Text="0 / 15"
                               FontSize="13" Foreground="Gray" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ProgressBar x:Name="OverallProgress" Height="8" Value="0" Maximum="60"
                         Foreground="#0078D4" Background="#E0E0E0" Margin="0,0,0,4" />
            <TextBlock x:Name="OverallProgressText" Text="0 / 60"
                       FontSize="11" Foreground="Gray" HorizontalAlignment="Right" Margin="0,0,0,12" />

            <!-- Live confusion matrix (simplified) -->
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                    Padding="12" Background="#FAFAFA" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="LR" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="LF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="RR" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="RF" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />

                    <TextBlock x:Name="CmRow0Label" Grid.Row="1" Grid.Column="0" Text="LR" FontWeight="SemiBold" FontSize="11" Margin="0,2,4,2" />
                    <TextBlock x:Name="Cm00" Grid.Row="1" Grid.Column="1" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm01" Grid.Row="1" Grid.Column="2" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm02" Grid.Row="1" Grid.Column="3" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm03" Grid.Row="1" Grid.Column="4" FontSize="11" HorizontalAlignment="Center" Margin="2" />

                    <TextBlock x:Name="CmRow1Label" Grid.Row="2" Grid.Column="0" Text="LF" FontWeight="SemiBold" FontSize="11" Margin="0,2,4,2" />
                    <TextBlock x:Name="Cm10" Grid.Row="2" Grid.Column="1" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm11" Grid.Row="2" Grid.Column="2" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm12" Grid.Row="2" Grid.Column="3" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm13" Grid.Row="2" Grid.Column="4" FontSize="11" HorizontalAlignment="Center" Margin="2" />

                    <TextBlock x:Name="CmRow2Label" Grid.Row="3" Grid.Column="0" Text="RR" FontWeight="SemiBold" FontSize="11" Margin="0,2,4,2" />
                    <TextBlock x:Name="Cm20" Grid.Row="3" Grid.Column="1" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm21" Grid.Row="3" Grid.Column="2" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm22" Grid.Row="3" Grid.Column="3" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm23" Grid.Row="3" Grid.Column="4" FontSize="11" HorizontalAlignment="Center" Margin="2" />

                    <TextBlock x:Name="CmRow3Label" Grid.Row="4" Grid.Column="0" Text="RF" FontWeight="SemiBold" FontSize="11" Margin="0,2,4,2" />
                    <TextBlock x:Name="Cm30" Grid.Row="4" Grid.Column="1" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm31" Grid.Row="4" Grid.Column="2" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm32" Grid.Row="4" Grid.Column="3" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                    <TextBlock x:Name="Cm33" Grid.Row="4" Grid.Column="4" FontSize="11" HorizontalAlignment="Center" Margin="2" />
                </Grid>
            </Border>

            <TextBlock x:Name="FeedbackText" Text="Tap the highlighted zone."
                       FontSize="12" Foreground="Gray" Margin="0,0,0,8" />
            <TextBlock x:Name="GuidanceText" Text="Arm to begin."
                       FontSize="11" Foreground="Gray" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="ArmButton" Content="Arm / Disarm"
                        Padding="16,8" Margin="0,0,6,0" Click="OnToggleArm" />
                <Button x:Name="CancelButton" Content="Cancel"
                        Padding="16,8" Background="#E0E0E0" Margin="6,0,0,0" Click="OnCancel" />
            </StackPanel>
        </StackPanel>

        <!-- Results panel -->
        <StackPanel x:Name="ResultsPanel" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
            <TextBlock Text="Accuracy Test — Results"
                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8"
                    Padding="20" Background="#FAFAFA" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ResultOverall" Text="" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,12" />

                    <!-- Confusion matrix results -->
                    <TextBlock Text="Confusion Matrix" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ConfusionGrid" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Per-zone accuracy -->
                    <TextBlock Text="Per-Zone Accuracy" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ZoneResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ZoneName}" FontWeight="SemiBold" FontSize="12" />
                                        <ProgressBar Grid.Column="1" Value="{Binding Accuracy}" Height="14"
                                                     Foreground="#0078D4" Background="#E0E0E0"
                                                     Margin="4,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding AccuracyText}"
                                                   FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Save Report" Padding="16,8"
                        Margin="0,0,6,0" Click="OnSaveReport" />
                <Button Content="Run Again" Padding="16,8"
                        Background="#E0E0E0" Margin="6,0,0,0" Click="OnRunAgain" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
