<Window x:Class="Holo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Holo — Desk Tap Detection"
        Width="1020" Height="680"
        MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App title -->
                <TextBlock Grid.Row="0" Text="Holo" FontSize="20" FontWeight="Medium"
                           Margin="16,20,16,12" Foreground="#1A1A1A" />

                <!-- Navigation -->
                <ListBox Grid.Row="1" x:Name="NavListBox"
                         BorderThickness="0" Background="Transparent"
                         SelectedIndex="0"
                         SelectionChanged="OnNavigationChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,8" />
                            <Setter Property="Margin" Value="4,0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem x:Name="NavDesk">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬡" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Desk" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavCalibrate">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◎" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Calibration" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavActions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Actions" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavEvaluate">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Accuracy Test" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavDiagnostics">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="∿" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Diagnostics" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Microphone status footer -->
                <Border Grid.Row="2" Background="Transparent" Padding="12,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse x:Name="MicStatusDot" Width="8" Height="8"
                                     Fill="Gray" Margin="0,0,6,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="MicStatusText" Text="Microphone off"
                                       FontSize="11" Foreground="Gray" />
                        </StackPanel>
                        <ProgressBar x:Name="MicLevelBar" Height="4"
                                     Value="0" Maximum="1"
                                     Foreground="#0078D4" Background="#E0E0E0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1">
            <TextBlock x:Name="PageTitle" Text="Desk"
                       FontSize="22" FontWeight="SemiBold"
                       Margin="24,20,24,0" VerticalAlignment="Top" />

            <!-- Page content panels -->
            <ContentControl x:Name="PageContent" Margin="24,60,24,24" />
        </Grid>
    </Grid>
</Window>
